#!/usr/bin/env bash
# cmux-review — launch the diff reviewer for the current repo.
# Runs from wherever you are; defaults --cwd to $PWD.
#
#   cmux-review                 # review working tree vs HEAD
#   cmux-review -- main...HEAD  # review a branch range
#   cmux-review --surface surface:34   # explicit target pane
set -euo pipefail
# Resolve through symlinks (npm global bin, ~/bin) to find server.mjs next to us.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  D="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$D/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec node "$DIR/server.mjs" --cwd "$PWD" "$@"
